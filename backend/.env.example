# Copy to .env and edit. A real environment variable always wins over this file.

# --- storage -------------------------------------------------------------------
# "database" (default) persists to DATABASE_URL.
# "memory" keeps the whole board in process: no database, seeded demo data,
# everything lost on restart. This is the demo mode.
KANBUNNY_STORE=database

# Any SQLAlchemy URL. Ignored when KANBUNNY_STORE=memory.
#   sqlite:///./kanbunny.db                       (default, a file next to pyproject.toml)
#   sqlite://                                     (in-memory SQLite, also non-persistent)
#   postgresql+psycopg://user:pass@localhost/kanbunny   (needs: uv add psycopg[binary])
DATABASE_URL=sqlite:///./kanbunny.db

# Log every statement SQLAlchemy runs. Noisy; useful when a query misbehaves.
KANBUNNY_ECHO_SQL=false

# Create the demo account and its board at startup. With a database, an existing
# board is left alone; only an empty one gets seeded.
KANBUNNY_SEED_DEMO=true

# --- auth ----------------------------------------------------------------------
# SET THIS. Tokens are signed with it, and the built-in default is public, so
# anyone could mint a valid token. Any long random string:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
KANBUNNY_SECRET_KEY=

KANBUNNY_TOKEN_TTL_MINUTES=720

# --- demo account --------------------------------------------------------------
KANBUNNY_SEED_USERNAME=mila
KANBUNNY_SEED_PASSWORD=carrots123

# --- http ----------------------------------------------------------------------
# Only matters if the browser calls this service directly. With the Vite proxy
# (the default setup) every request looks same-origin and CORS never applies.
KANBUNNY_CORS_ORIGINS=http://localhost:8080,http://localhost:8081,http://localhost:5173
