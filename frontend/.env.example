# Copy to .env to change how the frontend gets its data.

# mock (default) - in-memory demo data in the browser. No backend, no sign-in.
# http           - the FastAPI service in ../backend, with a sign-in screen.
VITE_API_MODE=mock

# Where `vite dev` forwards /api when VITE_API_MODE=http.
VITE_API_PROXY_TARGET=http://localhost:8000

# Leave empty in development so requests stay relative (/api/tasks) and are proxied.
# For a deployed build, set the API's origin, e.g. https://api.example.com — that makes
# requests cross-origin, so the backend's KANBUNNY_CORS_ORIGINS must list this site.
VITE_API_BASE_URL=
